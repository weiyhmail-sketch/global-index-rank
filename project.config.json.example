{
  "description": "指数涨跌总览 —— 复制为 project.config.json 并填入自己的 AppID",
  "appid": "your-appid",
  "projectname": "index-rank",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "libVersion": "3.17.2",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "nodeModules": false
  },
  "packOptions": {
    "ignore": [],
    "include": []
  }
}
