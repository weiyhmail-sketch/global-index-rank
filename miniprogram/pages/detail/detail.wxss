page { background: #f6f7f9; }
.wrap { padding: 24rpx 24rpx 60rpx; }
.card { background:#fff; border:1rpx solid #e6e8ec; border-radius:24rpx; padding:24rpx; margin-bottom:20rpx; }
.hint { color:#6b7280; font-size:26rpx; }
.err { color:#e0403f; }

.top { display:flex; align-items:center; gap:16rpx; }
.flag { font-size:44rpx; }
.ttl { flex:1; min-width:0; }
.c { font-size:32rpx; font-weight:700; }
.n { font-size:23rpx; color:#6b7280; margin-top:2rpx; }
.lv { text-align:right; }
.lvv { font-size:32rpx; font-weight:650; }
.lvd { font-size:20rpx; color:#9aa0a8; margin-top:2rpx; }

.pickers { display:flex; align-items:center; gap:12rpx; margin:22rpx 0 12rpx; flex-wrap:wrap; }
.sel { padding:8rpx 18rpx; border-radius:14rpx; background:#eef0f3; border:1rpx solid #e6e8ec; font-size:23rpx; }
.caret { color:#9aa0a8; font-size:18rpx; margin-left:4rpx; }
.cstat { font-size:21rpx; color:#6b7280; margin-left:auto; }

.chart { width:100%; height:360rpx; }
.nocur { height:360rpx; display:flex; align-items:center; justify-content:center; color:#9aa0a8; font-size:24rpx; }

.h { font-size:26rpx; font-weight:600; margin-bottom:18rpx; }
.grid { display:flex; flex-wrap:wrap; }
.cell { width:25%; padding:12rpx 0; }
.cl { font-size:20rpx; color:#9aa0a8; }
.cv { font-size:26rpx; font-weight:650; margin-top:4rpx; }
.up { color:#e0403f; } .down { color:#1a9c5b; } .flat { color:#9aa0a8; font-weight:400; }

.meta { font-size:21rpx; color:#6b7280; line-height:1.7; }
.note { color:#b45309; }

.snote { font-size:19rpx; color:#9aa0a8; text-align:right; margin-top:-8rpx; }

/* 逐年涨幅 */
.yrow { display:flex; align-items:center; padding:12rpx 0; border-bottom:1rpx solid #f0f1f4; }
.yrow:last-child { border-bottom:none; }
.ylab { width:190rpx; font-size:23rpx; color:#6b7280; flex:none; }
.ybar { position:relative; flex:1; height:22rpx; margin:0 12rpx; }
.ybar-zero { position:absolute; left:50%; top:0; bottom:0; width:1rpx; background:#e6e8ec; }
.ybar-fill { position:absolute; top:6rpx; height:10rpx; border-radius:3rpx; }
.up-bg { background:#e0403f; } .down-bg { background:#1a9c5b; }
.ypct { width:130rpx; text-align:right; font-size:25rpx; font-weight:650; flex:none; }
