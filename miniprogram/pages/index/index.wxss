page { background: #f6f7f9; }
.wrap { padding: 24rpx 24rpx 80rpx; }

.hd { margin-bottom: 20rpx; }
.title { font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.sub { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }

/* 吸顶单行筛选 */
.bar {
  position: sticky; top: 0; z-index: 9;
  margin: 0 -24rpx 20rpx; padding: 14rpx 24rpx;
  background: rgba(246,247,249,.94); backdrop-filter: blur(10px);
  border-bottom: 1rpx solid #e6e8ec;
  display: flex; gap: 12rpx; overflow-x: auto; white-space: nowrap;
}
.sel {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 10rpx 20rpx; border-radius: 16rpx;
  background: #eef0f3; border: 1rpx solid #e6e8ec;
  font-size: 25rpx; color: #14161a; white-space: nowrap;
}
.caret { color: #9aa0a8; font-size: 20rpx; }

.card {
  background: #fff; border: 1rpx solid #e6e8ec; border-radius: 24rpx;
  padding: 24rpx; margin-bottom: 20rpx;
}
.hint { color: #6b7280; font-size: 26rpx; }
.err { color: #e0403f; }

/* 结论条 */
.lede-hd { font-size: 23rpx; color: #6b7280; margin-bottom: 16rpx; }
.lede-row { display: flex; align-items: baseline; gap: 14rpx; margin: 8rpx 0; }
.lede-name { font-size: 40rpx; font-weight: 700; }
.lede-pct { font-size: 40rpx; font-weight: 700; margin-left: auto; }
.lede-tag { font-size: 21rpx; color: #6b7280; width: 52rpx; text-align: right; }
.stats { font-size: 23rpx; color: #6b7280; margin-top: 14rpx; }
.mv { margin-left: 16rpx; }
.flag { font-size: 30rpx; }
.flag.sm { font-size: 24rpx; margin-right: 4rpx; }

/* 榜单 */
.th {
  display: flex; align-items: center; font-size: 21rpx; color: #6b7280;
  padding-bottom: 14rpx; border-bottom: 1rpx solid #e6e8ec;
}
.th-rk { width: 76rpx; text-align: center; }
.th-nm { flex: 1; }
.th-pc { width: 150rpx; text-align: right; }

.row {
  display: flex; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #f0f1f4;
}
.rk {
  width: 76rpx; text-align: center; font-size: 23rpx; color: #6b7280;
  display: flex; align-items: center; justify-content: center; gap: 2rpx;
}
.delta { font-size: 18rpx; font-weight: 600; }
.nm { flex: 1; display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
/* 国名必须整行显示：不加 nowrap 会被 flex 压成「韩/国」「澳大/利亚」 */
.country { font-size: 29rpx; font-weight: 600; white-space: nowrap; flex: none; }
.idx {
  font-size: 21rpx; color: #6b7280; flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.pc { width: 150rpx; text-align: right; font-size: 28rpx; font-weight: 650; }
.bar-cell { position: relative; width: 150rpx; height: 24rpx; margin-left: 16rpx; }
.bar-zero { position: absolute; left: 50%; top: 0; bottom: 0; width: 1rpx; background: #e6e8ec; }
.bar-fill { position: absolute; top: 7rpx; height: 10rpx; border-radius: 3rpx; }
.up-bg { background: #e0403f; }
.down-bg { background: #1a9c5b; }

.up { color: #e0403f; }
.down { color: #1a9c5b; }
.flat, .na { color: #9aa0a8; font-weight: 400; }

.detail { background: #f3f4f6; border-radius: 16rpx; padding: 18rpx 20rpx; margin: 4rpx 0 12rpx; }
.calc { font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.calc-eq { color: #6b7280; font-size: 24rpx; font-weight: 400; }
.dmeta { font-size: 21rpx; color: #6b7280; line-height: 1.7; }

.note {
  margin-top: 18rpx; padding: 16rpx 20rpx; border-radius: 16rpx;
  background: #fdecec; font-size: 22rpx; color: #6b7280; line-height: 1.6;
}
.about { text-align: center; color: #6b7280; font-size: 25rpx; }

/* 自定义月度区间 */
.months { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; }
.msel {
  padding: 12rpx 24rpx; border-radius: 16rpx;
  background: #eef0f3; border: 1rpx solid #e6e8ec; font-size: 26rpx;
}
.marrow { color: #9aa0a8; font-size: 26rpx; }
.mnote { width: 100%; font-size: 21rpx; color: #9aa0a8; margin-top: 4rpx; }

.dgo { margin-top: 12rpx; font-size: 23rpx; color: #2563eb; }

.stale { font-size: 22rpx; color: #b45309; margin-top: 6rpx; }
.sechd {
  font-size: 21rpx; color: #6b7280; line-height: 1.6;
  padding: 20rpx 0 10rpx; border-top: 1rpx solid #e6e8ec; margin-top: 10rpx;
}
.row.dim { opacity: .72; }
